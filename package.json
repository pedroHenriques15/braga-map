{
  "name": "braga-map",
  "version": "1.21.0",
  "private": true,
  "description": "Braga's real streets, buildings and hills, from OpenStreetMap, for games: the world in sections, and the tracks planned on it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./tracks/*.js": {
      "types": "./tracks/track.d.ts",
      "default": "./tracks/*.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "world/",
    "tracks/"
  ],
  "scripts": {
    "test": "node --test",
    "map": "node tools/serve.mjs",
    "fetch": "node tools/fetch.mjs",
    "page": "node tools/build.mjs",
    "open": "node tools/open.mjs",
    "shooter": "node tools/shooter.mjs",
    "world": "node tools/world.mjs",
    "tracks": "node tools/track.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "clipper-lib": "^6.4.2",
    "geotiff": "^3.0.5",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "laz-perf": "^0.0.7",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5"
  }
}
